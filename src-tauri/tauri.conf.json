{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hares-Panel",
  "version": "../package.json",
  "identifier": "app.hares.nav",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hares-Panel",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "本地优先的导航首页",
    "longDescription": "Hares-Panel 是一个本地优先的导航首页，支持分组、图标库、内外网切换、小窗口、多账号与备份恢复。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}