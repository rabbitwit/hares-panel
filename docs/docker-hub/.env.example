# Hares-Panel Docker Hub 部署配置
# 复制为 .env 后修改：cp .env.example .env

# Docker Hub 镜像名，必须改成实际存在的镜像
HARES_IMAGE=your-dockerhub-name/hares-panel:latest

# 管理员密码。留空时容器首次启动自动生成，并保存到 ./data/admin-password
ADMIN_PASSWORD=

# 可选：HMAC 登录令牌签名密钥。留空时自动生成并保存到 ./data/session-secret
SESSION_SECRET=

# 面板宿主机端口，默认 18000，不占用 80/443
PANEL_PORT=18000

# 单次保存的导航数据 / 单张图片大小上限（MB）
HARES_STATE_MAX_MB=16
HARES_ASSET_MAX_MB=16

# 容器时区
TZ=Asia/Shanghai
