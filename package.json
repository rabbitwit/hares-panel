{
  "name": "hares-panel",
  "private": true,
  "version": "0.1.2",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "description": "A Sun-Panel style navigation homepage backed by Cloudflare Workers, Vercel or EdgeOne Makers, with server-side storage.",
  "scripts": {
    "dev": "vite",
    "dev:api": "node tests/mock-server.mjs --api-only",
    "build": "node scripts/build.mjs",
    "build:docker": "node scripts/build-docker.mjs",
    "build:fnos": "node scripts/prepare-fnos.mjs",
    "build:direct": "tsc --noEmit && vite build",
    "start": "node server-dist/index.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --pretty false",
    "test:api": "node tests/api-core.test.mjs && node tests/sync.test.mjs && node tests/server-runtimes.test.mjs && node tests/edgeone.test.mjs && node tests/backup.test.mjs && node tests/docker-runtime.test.mjs && node tests/fnos-package.test.mjs",
    "mock:api": "node tests/mock-server.mjs",
    "deploy:cf": "npm run build && wrangler deploy",
    "deploy:vercel": "npm run build && npx vercel --prod",
    "docker:build": "docker build -t hares-panel:latest .",
    "docker:up": "docker compose up -d --build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@edgeone/pages-blob": "^0.0.18",
    "@fontsource-variable/inter": "^5.2.8",
    "@iconify-json/logos": "^1.2.4",
    "@iconify-json/lucide": "^1.2.60",
    "@iconify-json/simple-icons": "^1.2.50",
    "@iconify/react": "^6.0.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@vercel/blob": "^2.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.9.6",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.1",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "wrangler": "^4.41.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}