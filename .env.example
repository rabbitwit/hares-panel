# Hares-Panel Docker 配置
# 复制为 .env 后修改；也可以直接运行 deploy.sh / deploy.ps1 自动生成。

# 管理员密码。留空时容器首次启动会自动生成，并打印在 docker logs 中。
ADMIN_PASSWORD=

# 可选：HMAC 登录令牌签名密钥。留空时自动生成并保存到 ./data/session-secret。
SESSION_SECRET=

# 面板宿主机端口。默认 18000，不会占用 NAS 的 80/443。
PANEL_PORT=18000

# 单次保存的导航数据 / 单张图片大小上限（MB）。
HARES_STATE_MAX_MB=16
HARES_ASSET_MAX_MB=16

# 可选：Alpine apk 镜像源，仅影响重新构建镜像时的下载速度。
# 不设置时构建会依次尝试国内镜像和官方源。
# APK_MIRROR=https://mirrors.aliyun.com/alpine

TZ=Asia/Shanghai
