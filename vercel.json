{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "node scripts/vercel-command.mjs npm install",
  "buildCommand": "node scripts/vercel-command.mjs npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/health.ts": {
      "maxDuration": 15,
      "includeFiles": "server/**"
    },
    "api/index.ts": {
      "maxDuration": 15,
      "includeFiles": "server/**"
    },
    "api/[...path].ts": {
      "maxDuration": 15,
      "includeFiles": "server/**"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
